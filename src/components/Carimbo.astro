---
// Carimbo de passaporte que marca cada seção.
interface Props {
  numero: string;
  rotulo: string;
  cor?: 'terracota' | 'mar';
  giro?: number;
}
const { numero, rotulo, cor = 'terracota', giro = -8 } = Astro.props;
const id = `carimbo-${numero}`;
---
<svg class:list={['carimbo', cor]} viewBox="0 0 100 100" aria-hidden="true" style={`transform: rotate(${giro}deg)`}>
  <defs>
    <path id={id} d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0" />
  </defs>
  <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" />
  <circle cx="50" cy="50" r="27" fill="none" stroke="currentColor" stroke-width="1.4" />
  <text font-size="8.6" letter-spacing="1.6">
    <textPath href={`#${id}`} textLength="214">PUNTA CANA · 2027 · I&amp;R ·</textPath>
  </text>
  <text class="num" x="50" y="52" text-anchor="middle">{numero}</text>
  <text x="50" y="64" text-anchor="middle" font-size="7.5" letter-spacing="1">{rotulo.toUpperCase()}</text>
</svg>
