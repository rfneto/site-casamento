---
// "Como chegar": um cartão por cidade de saída, com a opção recomendada em
// destaque (chega até o meio-dia de 10/05), as alternativas e a volta.
import TituloSecao from './TituloSecao.astro';
import { casamento as c } from '../data/casamento';
import type { Voo } from '../data/casamento';

const cc = c.comoChegar;
const blocos = (cid: (typeof cc.cidades)[number]) => {
  const lista: { rotulo: string; voo: Voo; destaque?: boolean }[] = [];
  if (cid.direto?.disponivel) lista.push({ rotulo: 'Voo direto', voo: cid.direto, destaque: true });
  lista.push({ rotulo: 'Recomendado', voo: cid.recomendado, destaque: !cid.direto?.disponivel });
  cid.alternativas.forEach((v) => lista.push({ rotulo: 'Alternativa', voo: v }));
  if (cid.volta) lista.push({ rotulo: 'Volta', voo: cid.volta });
  return lista;
};
---
<section id="voos" class="container secao revela">
  <TituloSecao>{cc.titulo}</TituloSecao>
  <p class="prazo">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2.5 19h19M3 13.5l4.5 1.5 4-3.5L6 6l2-.8 8 4.6 3.6-1.5a1.6 1.6 0 0 1 1.2 3l-14 5.7L3 13.5z"></path></svg>
    <strong>{cc.prazo}</strong>
  </p>

  <div class="voos">
    {cc.cidades.map((cid) => (
      <article class="voo-cidade">
        <h3><span class="voo-cod">{cid.aeroporto}</span> {cid.cidade} <span class="voo-seta" aria-hidden="true">→</span> <span class="voo-cod">PUJ</span><span class="so-leitor"> Punta Cana</span></h3>
        {cid.nota && <p class="voo-nota">{cid.nota}</p>}
        {blocos(cid).map(({ rotulo, voo, destaque }) => (
          <div class:list={['voo-opcao', { destaque, volta: rotulo === 'Volta' }]}>
            <p class="voo-rotulo">{rotulo}</p>
            <p class="voo-cia">{voo.companhia} <span>· {voo.rota}</span></p>
            <ul class="voo-horarios">
              {voo.trechos.map((t) => <li>{t}</li>)}
            </ul>
            <p class="voo-meta">
              {voo.duracao && <span>Tempo: {voo.duracao}</span>}
              {voo.preco && <span class="voo-preco">{voo.preco}</span>}
            </p>
          </div>
        ))}
        {cid.avisos.length > 0 && (
          <ul class="voo-avisos">
            {cid.avisos.map((a) => <li>{a}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
  <p class="fontes">{cc.aviso}</p>
</section>
