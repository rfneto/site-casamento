---
// Divisor em forma de onda / linha do horizonte entre duas seções.
// O linho (fundo com textura) aparece por transparência.
interface Props { de: string; para: string; invertida?: boolean }
const { de, para, invertida = false } = Astro.props;
const LINHO = '#f6f1e7';
const curva = 'M0 30 C 180 6 360 6 540 24 S 900 46 1080 26 S 1320 8 1440 22';
// Se a seção de baixo é linho, pinta a parte de cima com a cor da seção de cima.
const deCima = para === LINHO;
const d = deCima ? `${curva} V0 H0 Z` : `${curva} V48 H0 Z`;
const fundo = deCima || de === LINHO ? 'transparent' : de;
---
<svg class="onda" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true" style={`background:${fundo};${invertida ? 'transform:scaleX(-1)' : ''}`}>
  <path fill={deCima ? de : para} d={d}></path>
</svg>
