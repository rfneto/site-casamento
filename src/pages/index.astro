---
// Página única do site. Os textos vêm de src/data/casamento.ts.
// Identidade visual: as cangas que a Ilma fez para os convidados.
import '../styles/global.css';
import Historia from '../components/Historia.astro';
import Resort from '../components/Resort.astro';
import ComoChegar from '../components/ComoChegar.astro';
import Mural from '../components/Mural.astro';
import Ilustracao from '../components/Ilustracao.astro';
import TituloSecao from '../components/TituloSecao.astro';
import { casamento as c } from '../data/casamento';
import { urlGoogleAgenda } from '../data/agenda';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { noivos, data, local } = c;

const textoData = data.confirmada ? data.textoConfirmado : data.textoProvisorio;
// "Terça-feira, 11 de maio de 2027" → quebra de linha só depois da vírgula
const partesData = textoData.split(/,\s*/);
const mostrarHotel = local.hotelConfirmado && local.hotel.nome.trim() !== '';
const dias = c.programacao.dias as import('../data/casamento').Dia[];
const alvo = new Date(data.cerimonia).getTime();
const diasFaltando = Math.max(0, Math.floor((alvo - Date.now()) / 86400000));

// Programação: itens com `oculto: true` não aparecem
const diasVisiveis = dias
  .map((d) => ({ ...d, itens: d.itens.filter((it) => !it.oculto) }))
  .filter((d) => d.itens.length > 0);

// Fusos: horário da cerimônia em cada lugar, calculado a partir da data
const horaEm = (zona: string) => {
  const t = new Intl.DateTimeFormat('pt-BR', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: zona }).format(new Date(data.cerimonia));
  return t.endsWith(':00') ? `${Number(t.slice(0, 2))}h` : t.replace(':', 'h');
};
const fusos = c.viagem.fusos.lugares.map((l) => ({ ...l, hora: horaEm(l.zona) }));

const menu = [
  { href: '#historia', texto: 'História' },
  { href: '#casamento', texto: 'Casamento' },
  { href: '#resort', texto: mostrarHotel ? 'Resort' : 'Hospedagem' },
  { href: '#programacao', texto: 'Programação' },
  { href: '#voos', texto: 'Voos' },
  { href: '#viagem', texto: 'Viagem' },
  { href: '#mural', texto: 'Mural' },
  { href: '#duvidas', texto: 'Dúvidas' },
  ...(c.presentes.ligada ? [{ href: '#presentes', texto: 'Presentes' }] : []),
];

const ogImagem = new URL('og.jpg', c.seo.url).toString();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{c.seo.titulo}</title>
  <meta name="description" content={c.seo.descricao} />
  <!-- Fora dos buscadores -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot" content="noindex, nofollow" />
  <meta name="theme-color" content="#ffffff" />

  <!-- Open Graph (prévia do link no WhatsApp) -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={c.seo.titulo} />
  <meta property="og:description" content={c.seo.descricao} />
  <meta property="og:url" content={c.seo.url} />
  <meta property="og:image" content={ogImagem} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ilma & Ruy · Maio 2027 — listras de aquarela azul, coqueiro e espreguiçadeiras" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Damion&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap" rel="stylesheet" />
  <link rel="preload" as="image" href={`${base}ilustracoes/listras-aquarela.webp`} type="image/webp" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <header class="topo">
    <div class="topo-inner container">
      <div class="topo-linha">
        <a class="monograma" href="#inicio" aria-label={`${noivos.primeiro} e ${noivos.segundo} — início`}>{noivos.primeiro.charAt(0)}&amp;{noivos.segundo.charAt(0)}</a>
        <a class="botao botao-indigo" href="#viagem">Checklist</a>
      </div>
      <nav aria-label="Seções">
        <ul class="menu">
          {menu.map((m) => <li><a href={m.href}>{m.texto}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>

  <main id="conteudo">
    <!-- ================= ABERTURA: a canga ================= -->
    <section id="inicio" class="canga">
      <div class="canga-listras" data-paralaxe aria-hidden="true"></div>

      <Ilustracao nome="coqueiro" class="canga-coqueiro" largura={447} altura={800} carregar="eager" />
      <div class="canga-cadeiras" aria-hidden="true">
        <Ilustracao nome="espreguicadeira" largura={420} altura={425} carregar="eager" />
        <Ilustracao nome="espreguicadeira" largura={420} altura={425} carregar="eager" />
      </div>
      <div class="canga-data" aria-hidden="true">
        <Ilustracao nome="estrela-do-mar" class="estrela-gira" largura={240} altura={231} carregar="eager" />
      </div>

      <div class="canga-centro">
        <h1 class="nomes surge">{noivos.primeiro} <span class="e">&amp;</span> {noivos.segundo}</h1>

        <div class="canga-painel surge-2">
          <p class="quando">
            <span class="quando-data">{partesData.map((t, i) => <>{i > 0 && ' '}<span class="nw">{t}{i < partesData.length - 1 ? ',' : ` · ${c.evento.cerimonia.horario}`}</span></>)}</span>
            <span class="quando-local">{mostrarHotel && <>{local.hotel.nome} · </>}{local.cidade}, {local.pais}</span>
          </p>

          <ul class="contagem" data-contagem data-alvo={data.cerimonia} aria-label="Contagem regressiva para a cerimônia">
            <li><span class="num" data-cd="d">{diasFaltando}</span><span class="rot">dias</span></li>
            <li><span class="num" data-cd="h">--</span><span class="rot">horas</span></li>
            <li><span class="num" data-cd="m">--</span><span class="rot">min</span></li>
            <li><span class="num" data-cd="s">--</span><span class="rot">seg</span></li>
          </ul>
          {!data.confirmada && <p class="contagem-nota">Contagem até a data provisória; o dia exato será confirmado em breve.</p>}
        </div>

        <div class="acoes surge-2">
            <a class="botao botao-indigo" href="#viagem">Checklist da viagem</a>
            <details class="agenda">
              <summary class="botao botao-contorno">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                Salvar na agenda
              </summary>
              <div class="agenda-menu">
                <a href={urlGoogleAgenda} target="_blank" rel="noopener">
                  <span>Google Agenda<small>abre em nova aba</small></span>
                </a>
                <a href={`${base}casamento.ics`} download="casamento-ilma-ruy.ics">
                  <span>iPhone, Outlook e outros<small>arquivo .ics</small></span>
                </a>
              </div>
            </details>
        </div>
      </div>
    </section>

    <!-- ================= NOSSA HISTÓRIA ================= -->
    <Historia />

    <div class="faixa-listras" aria-hidden="true"></div>

    <!-- ================= O CASAMENTO ================= -->
    <section id="casamento" class="container secao revela">
      <TituloSecao>O casamento</TituloSecao>
      <div class="cartoes">
        <article class="cartao">
          <span class="destaque">{c.evento.cerimonia.horario}</span>
          <h3>{c.evento.cerimonia.titulo}</h3>
          <p>{c.evento.cerimonia.texto}</p>
        </article>
        <article class="cartao">
          <span class="destaque menor">Em seguida</span>
          <h3>{c.evento.depois.titulo}</h3>
          <p>{c.evento.depois.texto}</p>
        </article>
        <article class="cartao">
          <span class="destaque menor">Dress code</span>
          <h3>{c.evento.dressCode.titulo}</h3>
          <p>{c.evento.dressCode.texto}</p>
        </article>
      </div>
    </section>

    <div class="faixa-listras" aria-hidden="true"></div>

    <!-- ================= O RESORT ================= -->
    <Resort />

    <div class="faixa-listras" aria-hidden="true"></div>

    <!-- ================= PROGRAMAÇÃO ================= -->
    <section id="programacao" class="container secao programacao revela">
      <div>
        <TituloSecao>Programação</TituloSecao>
        <p class="suave sem-margem">
          {diasVisiveis.length ? `Nosso itinerário, dia a dia. Toque em cada dia para ver os horários. ${c.programacao.nota}` : 'O itinerário dos dias em Punta Cana vai morar aqui.'}
        </p>
        {diasVisiveis.length > 0 && (
          <div class="abas" role="tablist" aria-label="Dias da programação" data-abas>
            {diasVisiveis.map((d, i) => (
              <button class="aba" role="tab" id={`aba-${i}`} aria-controls={`dia-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{d.aba}</button>
            ))}
          </div>
        )}
        <Ilustracao nome="espreguicadeira" class="cadeira-programacao" largura={420} altura={425} />
      </div>

      {diasVisiveis.length > 0 ? (
        <div class="itinerario">
          {diasVisiveis.map((d, i) => (
            <div role="tabpanel" id={`dia-${i}`} aria-labelledby={`aba-${i}`} hidden={i !== 0} tabindex="0">
              <h3>{d.titulo}</h3>
              {d.aviso && <p class="dia-aviso">{d.aviso}</p>}
              <ol>
                {d.itens.map((it) => (
                  <li>
                    <span class="hora">{it.horario}</span>
                    <span>
                      <span class="ativ">{it.atividade}{it.aConfirmar && <span class="a-confirmar">a confirmar</span>}</span>
                      <span class="det">{[it.local, it.observacao].filter(Boolean).join(' · ')}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      ) : (
        <div class="em-breve">
          <span class="em-breve-titulo">Em breve</span>
          <p>{c.programacao.textoVazio}</p>
        </div>
      )}
    </section>

    <div class="faixa-listras" aria-hidden="true"></div>

    <!-- ================= COMO CHEGAR ================= -->
    <ComoChegar />

    <div class="faixa-listras" aria-hidden="true"></div>

    <!-- ================= VIAGEM / CHECKLIST ================= -->
    <section id="viagem" class="container secao revela">
      <TituloSecao>{c.viagem.titulo}</TituloSecao>
      <div class="barra-check">
        <p>{c.viagem.intro}</p>
        <div class="contador">
          <span class="pilula" aria-live="polite"><span data-prontos>0</span> de {c.viagem.checklist.length} prontos</span>
          <button class="desmarcar" type="button" data-desmarcar>Desmarcar tudo</button>
        </div>
      </div>
      <div class="progresso" aria-hidden="true"><span data-progresso></span></div>

      <ul class="checklist" data-checklist>
        {c.viagem.checklist.map((q) => (
          <li data-item={q.id}>
            <button class="check" type="button" aria-pressed="false" data-id={q.id}>
              <svg class="marca" viewBox="0 0 28 28" aria-hidden="true">
                <circle cx="14" cy="14" r="12.5" fill="none" stroke="#A0B0E0" stroke-width="1.6"></circle>
                <circle class="cheio" cx="14" cy="14" r="13" fill="#748B3E"></circle>
                <path class="ok" d="M8 14.5 L12 18.5 L20 10" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <span>
                <span class="rot">{q.rotulo}</span>
                <span class="tit">{q.titulo}</span>
                <span class="txt">{q.texto}</span>
              </span>
            </button>
            {q.link && <a class="botao botao-indigo check-link" href={q.link.url} target="_blank" rel="noopener" hreflang="pt">{q.link.texto}</a>}
          </li>
        ))}
      </ul>

      <dl class="infos">
        {c.viagem.infos.map((i) => (
          <div class="info"><dt>{i.rotulo}</dt><dd>{i.texto}</dd></div>
        ))}
      </dl>

      <div class="viagem-caixas">
        <article class="caixa">
          <h3>{c.viagem.fusos.titulo}</h3>
          <p>{c.viagem.fusos.texto}</p>
          <table class="tabela">
            <caption class="so-leitor">Horário da cerimônia em cada fuso</caption>
            <thead><tr><th scope="col">Lugar</th><th scope="col">Cerimônia</th></tr></thead>
            <tbody>
              {fusos.map((f) => (
                <tr><th scope="row">{f.nome}<small>{f.descricao}</small></th><td>{f.hora}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="caixa-exemplo">Exemplo: cerimônia às {fusos.map((f) => `${f.hora} ${f.nome === 'Punta Cana' ? 'em Punta Cana' : f.nome === 'Itália' ? 'na Itália' : `em ${f.nome}`}`).join(' = ')}.</p>
        </article>

        <article class="caixa">
          <h3>{c.viagem.gorjetas.titulo}</h3>
          <p>{c.viagem.gorjetas.texto}</p>
          <table class="tabela">
            <caption>{c.viagem.gorjetas.tabelaTitulo}</caption>
            <tbody>
              {c.viagem.gorjetas.tabela.map((g) => (
                <tr><th scope="row">{g.quem}</th><td>{g.quanto}{g.obs && <small>{g.obs}</small>}</td></tr>
              ))}
            </tbody>
          </table>
        </article>
      </div>

      <p class="fontes">
        Conferido em {c.viagem.dataChecagem}. Fontes oficiais:{' '}
        {c.viagem.fontes.map((f, i) => (
          <>{i > 0 && ' · '}<a href={f.url} target="_blank" rel="noopener">{f.texto}</a></>
        ))}. {c.viagem.aviso}
      </p>
    </section>

    <div class="faixa-listras" aria-hidden="true"></div>

    <!-- ================= MURAL ================= -->
    <Mural />

    <div class="faixa-listras" aria-hidden="true"></div>

    <!-- ================= DÚVIDAS ================= -->
    <section id="duvidas" class="container secao revela">
      <TituloSecao centro>Perguntas frequentes</TituloSecao>
      <div class="faq">
        {c.faq.map((f) => (
          <details>
            <summary><span>{f.pergunta}</span><span class="sinal" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg></span></summary>
            <p>{f.resposta}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ================= PRESENTES (desligado por padrão) ================= -->
    {c.presentes.ligada && (
      <>
        <div class="faixa-listras" aria-hidden="true"></div>
        <section id="presentes" class="container secao revela">
          <div class="presentes">
            <TituloSecao centro>{c.presentes.titulo}</TituloSecao>
            <p class="suave">{c.presentes.texto}</p>
            <div class="acoes">
              {c.presentes.links.map((l) => <a class="botao botao-indigo" href={l.url} target="_blank" rel="noopener">{l.texto}</a>)}
            </div>
          </div>
        </section>
      </>
    )}
  </main>

  <!-- ================= ENCERRAMENTO + RODAPÉ (sobre as listras) ================= -->
  <footer class="rodape">
    <div class="rodape-cartao revela">
      <Ilustracao nome="coqueiro" class="rodape-coqueiro" largura={447} altura={800} />
      <p class="rodape-faltam">Faltam <span data-cd="d">{diasFaltando}</span> dias</p>
      <p class="rodape-titulo">{c.encerramento.titulo}</p>
      <p class="rodape-texto">{c.encerramento.texto}</p>
      <p class="assina">{noivos.primeiro} &amp; {noivos.segundo} · {local.cidade} {new Date(data.cerimonia).getFullYear()}</p>
    </div>
  </footer>

  <script>
    import '../scripts/site';
  </script>
</body>
</html>
